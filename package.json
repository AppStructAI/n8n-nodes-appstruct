{
	"name": "n8n-nodes-appstruct",
	"version": "2.0.0",
	"description": "n8n community nodes for AppStruct App Builder projects, tables and records",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"appstruct",
		"backend",
		"database",
		"api",
		"no-code"
	],
	"license": "MIT",
	"homepage": "https://appstruct.ai",
	"author": {
		"name": "AppStruct",
		"email": "support@appstruct.cloud"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/AppStructAI/n8n-nodes-appstruct.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"format": "prettier nodes --write",
		"lint": "n8n-node lint",
		"lintfix": "n8n-node lint --fix",
		"prepublishOnly": "npm run lint && npm test && npm run check:scanner && npm run check:package",
		"test:credentials": "npm run build && node --test scripts/credential-test.test.cjs",
		"check:scanner": "node scripts/check-scanner.mjs",
		"test": "npm run build && node --test scripts/*.test.cjs",
		"test:runtime": "node scripts/runtime-smoke.mjs",
		"check:package": "node scripts/check-package.mjs"
	},
	"files": [
		"dist",
		"examples/list-projects-read-only.json"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/nodes/credentials/AppStructApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AppStruct/AppStruct.node.js",
			"dist/nodes/AppStruct/AppStructTrigger.node.js"
		],
		"strict": true
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.4",
		"@n8n/scan-community-package": "0.43.0",
		"eslint": "9.29.0",
		"n8n-workflow": "2.16.0",
		"prettier": "3.6.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
